# Pair using the web page (recommended). Optional: set PHONE_NUMBER to also print the code in logs.
PHONE_NUMBER=

# Password for the pairing web page (set this!)
PAIR_PASSWORD=change-me
PORT=8000

# After first successful pairing the bot prints SESSION_B64 in the logs.
# Paste it here so the bot reconnects after every restart/redeploy.
SESSION_B64=

# Optional
ALLOWED_NUMBERS=
MAX_VIDEO_MB=90
MAX_FILESIZE=200M
MAX_PARALLEL=2
YTDLP_EXTRA_ARGS=
